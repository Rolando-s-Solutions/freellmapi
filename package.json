{
  "name": "freellmapi-vscode",
  "displayName": "FreeLLMAPI for VS Code",
  "description": "Bring FreeLLMAPI's model router (auto, fusion, 70+ open models) into VS Code Chat & Agent mode — zero config, secure API-key storage, streaming, and full tool calling support.",
  "version": "0.1.4",
  "publisher": "rolando-s-solutions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onCommand:freellmapi.configure",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "freellmapi",
        "displayName": "FreeLLMAPI for VS Code",
        "managementCommand": "freellmapi.configure"
      }
    ],
    "commands": [
      {
        "command": "freellmapi.configure",
        "title": "FreeLLMAPI: Configure Connection"
      }
    ],
    "configuration": {
      "title": "FreeLLMAPI",
      "properties": {
        "freellmapi.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:31415/v1",
          "description": "FreeLLMAPI OpenAI-compatible API base URL. Use /v1 for local server installs or the desktop app URL."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rolandossolutions/freellmapi.git"
  },
  "homepage": "https://github.com/rolandossolutions/freellmapi#readme",
  "bugs": {
    "url": "https://github.com/rolandossolutions/freellmapi/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "llm",
    "ai",
    "chat",
    "agent",
    "freellmapi",
    "openrouter",
    "models",
    "tools",
    "copilot"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc --watch -p .",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.104.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
